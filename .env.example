# ---------------------------------------------------------------
# HOVIDA (هویدا) — server configuration
# Copy to .env for local development. Never commit real keys.
# ---------------------------------------------------------------

# Server
PORT=3000
# DATA_DIR=./data                # JSON store + uploaded resume files (mount a persistent disk in production)
# APP_SECRET=                     # ≥16 chars; signs short-lived file links. Auto-generated into DATA_DIR if empty.

# AI engine: auto | gemini | openai | off   (auto = Gemini if its key exists, else the OpenAI-compatible gateway)
AI_PROVIDER=auto

# Google Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Any OpenAI-compatible gateway (OpenAI, or an Iranian provider)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Product options
# DISABLE_DEMO=1                  # hide «ورود به نسخه نمایشی»
# LEGACY_OWNER_EMAIL=hr@company.ir # only this signup adopts data from the old single-tenant version
