# ---------------------------------------------------------------
# HOVIDA (هویدا) — server configuration
# Copy to .env for local development. Never commit real keys.
# ---------------------------------------------------------------

# Server
PORT=3000
# DATA_DIR=./data                # JSON store + uploaded resume files (mount a persistent disk in production)
# Storage driver: fs (default — the DATA_DIR disk) | remote (an HTTP object store; set automatically
# on Cloudflare, where the data lives in R2 — see docs/DEPLOY-CLOUDFLARE.md).
# STORAGE_DRIVER=remote
# STORAGE_URL=http://127.0.0.1:8790   # e.g. `node scripts/mock-storage-server.mjs --port 8790` for local runs
# STORAGE_TOKEN=                      # optional shared token sent as X-Hovida-Storage-Token
# APP_SECRET=                     # ≥16 chars; signs file links AND encrypts the AI keys stored in /admin.
#                                  # Auto-generated into DATA_DIR if empty. Keep it stable.

# Platform admins (/admin). Alternative: the one-time setup code printed in the log at start-up.
# Sign up with the address right after deploying: e-mails are not verified, so the first
# account created with it gets the role (allowed even while public sign-up is closed).
# ADMIN_EMAILS=you@company.ir,ops@company.ir

# AI keys are best managed in /admin › کلیدهای هوش مصنوعی (up to 5, automatic failover).
# The variables below still work as a fallback after the admin keys.
# AI engine: auto | gemini | openai | off   (off = no AI at all, including /admin keys)
AI_PROVIDER=auto

# Google Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Any OpenAI-compatible gateway (OpenAI, or an Iranian provider)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Product options
# DISABLE_DEMO=1                  # hide «ورود به نسخه نمایشی»
# LEGACY_OWNER_EMAIL=hr@company.ir # the account (new or existing) that receives data from the old single-tenant version;
#                                  # unset = that data stays hidden (it is candidates' personal data)
# Real client IP for login/signup rate limits:
# CLIENT_IP_HEADER=cf-connecting-ip # header a trusted edge sets (Cloudflare). Automatic on Render.
# TRUST_PROXY_HOPS=1              # otherwise: proxies in front of the app, X-Forwarded-For read from the right (0 = none)

# ---------------------------------------------------------------
# Connections (optional; each workspace connects its own account in
# «تنظیمات ← اتصال‌ها». See docs/CONNECT-*.md.)
# ---------------------------------------------------------------

# Public address of this deployment (used for the Google OAuth redirect URI;
# without it the request origin is used).
# PUBLIC_URL=https://hr.example.com

# --- Optional. Both connections below can be entered in the admin panel instead:
#     /admin › «اتصال‌ها» (recommended: nothing to restart, values are encrypted).
#     A value saved there wins over the environment.

# Google Calendar — one OAuth client for the deployment.
# Google Cloud Console › APIs & Services › Credentials › OAuth client ID (Web application)
# Authorized redirect URI: <PUBLIC_URL>/api/integrations/calendar/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://hr.example.com/api/integrations/calendar/callback
# GOOGLE_CALENDAR_ID=primary        # or a shared calendar id the connected account can write to

# Talent sourcing — a LinkedIn-compatible provider the organization is licensed to use
# (or set it in /admin › «اتصال‌ها»; LINKEDIN_API_TOKEN is accepted too)
# (LinkedIn Talent Solutions / partner API, or a licensed data provider).
# The contract is documented in docs/CONNECT-LINKEDIN.md.
# LINKEDIN_API_URL=
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_PROVIDER_LABEL=LinkedIn Talent API

# Organizational e-mail (SMTP) is configured per workspace in the app, not here:
# the password is encrypted with APP_SECRET and never leaves the server.
