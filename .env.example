# ---------------------------------------------------------------
# HOVIDA (هویدا) — server configuration
# Copy to .env for local development. Never commit real keys.
# ---------------------------------------------------------------

# Server
PORT=3000
# DATA_DIR=./data                # JSON store + uploaded resume files (mount a persistent disk in production)
# APP_SECRET=                     # ≥16 chars; signs file links AND encrypts the AI keys stored in /admin.
#                                  # Auto-generated into DATA_DIR if empty. Keep it stable.

# Platform admins (/admin). Alternative: the one-time setup code printed in the log at start-up.
# ADMIN_EMAILS=you@company.ir,ops@company.ir

# AI keys are best managed in /admin › کلیدهای هوش مصنوعی (up to 5, automatic failover).
# The variables below still work as a fallback after the admin keys.
# AI engine: auto | gemini | openai | off   (off = no AI at all, including /admin keys)
AI_PROVIDER=auto

# Google Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Any OpenAI-compatible gateway (OpenAI, or an Iranian provider)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Product options
# DISABLE_DEMO=1                  # hide «ورود به نسخه نمایشی»
# LEGACY_OWNER_EMAIL=hr@company.ir # the account (new or existing) that receives data from the old single-tenant version;
#                                  # unset = that data stays hidden (it is candidates' personal data)
# Real client IP for login/signup rate limits:
# CLIENT_IP_HEADER=cf-connecting-ip # header a trusted edge sets (Cloudflare). Automatic on Render.
# TRUST_PROXY_HOPS=1              # otherwise: proxies in front of the app, X-Forwarded-For read from the right (0 = none)
