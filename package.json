{
  "name": "hovida",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx scripts/unit.test.ts && tsx scripts/duplicates.test.ts && tsx scripts/integrations.test.ts && tsx scripts/automation.test.ts && tsx scripts/ingest.test.ts && tsx scripts/behavior.test.ts && tsx scripts/keypool.test.ts && tsx scripts/server.test.ts && tsx scripts/api-timeout.test.ts && tsx scripts/storage.test.ts",
    "test:api": "node scripts/smoke.mjs",
    "test:mount": "vite build --config vite.mount.config.ts && node scripts/run-mount.mjs",
    "brand": "python3 scripts/brand/make_logo.py",
    "test:admin": "tsx scripts/admin-api.test.ts",
    "test:integrations": "npm run build && tsx scripts/integrations-api.test.ts",
    "build:cloudflare": "npm run build && node scripts/cloudflare/prepare-assets.mjs",
    "test:backup": "tsx scripts/backup.test.ts",
    "test:cloudflare": "tsx scripts/cloudflare.test.ts",
    "cf:typecheck": "tsc -p cloudflare/tsconfig.json",
    "cf:deploy": "wrangler deploy",
    "test:google": "npm run build && tsx scripts/google-calendar.test.ts",
    "mock:google": "node scripts/mock-google.mjs --port 9933",
    "mock:apify": "node scripts/mock-apify.mjs --port 9922",
    "mock:smtp": "node scripts/mock-smtp.mjs --port 2525",
    "test:apify": "npm run build && tsx scripts/apify-guard.test.ts",
    "test:automation": "npm run build && tsx scripts/automation-api.test.ts",
    "test:automation:unit": "tsx scripts/automation.test.ts",
    "test:offers": "npm run build && tsx scripts/offers-api.test.ts",
    "test:scheduling": "npm run build && tsx scripts/scheduling-api.test.ts",
    "test:collab": "npm run build && tsx scripts/collab-api.test.ts",
    "test:developer": "npm run build && tsx scripts/developer-api.test.ts",
    "test:retention": "npm run build && tsx scripts/retention-api.test.ts",
    "test:survey": "npm run build && tsx scripts/survey-api.test.ts",
    "test:2fa": "npm run build && tsx scripts/twofactor-api.test.ts",
    "test:blind": "npm run build && tsx scripts/blind-api.test.ts",
    "test:kit": "npm run build && tsx scripts/interview-kit-api.test.ts",
    "test:team": "npm run build && tsx scripts/team-cost-api.test.ts",
    "test:sso": "npm run build && tsx scripts/sso-api.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "core-js": "^3.50.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "heic-decode": "^2.1.0",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.2",
    "motion": "^12.23.24",
    "nodemailer": "^7.0.13",
    "omggif": "^1.0.10",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "utif2": "^4.1.0",
    "vazirmatn": "^33.0.3",
    "vite": "^6.2.3",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-legacy": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.1.14",
    "terser": "^5.51.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.151.1"
  },
  "description": "هویدا — تحلیل هوشمند رزومه برای تیم‌های منابع انسانی (HOVIDA, AI resume screening SaaS)"
}
