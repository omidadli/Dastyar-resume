{
  "id": "/",
  "name": "هویدا — سامانه جذب و استخدام",
  "short_name": "هویدا",
  "description": "غربالگری رزومه، پورتال شغلی، مصاحبهٔ ویدئویی، پیشنهاد شغلی و گزارش‌های استخدام در یک جا.",
  "lang": "fa",
  "dir": "rtl",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#F7F8F7",
  "theme_color": "#176F30",
  "categories": ["business", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "/brand/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/brand/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/brand/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/brand/hovida-app-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "میزکار", "short_name": "میزکار", "url": "/app", "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192" }] },
    { "name": "فرصت‌های شغلی", "short_name": "فرصت‌ها", "url": "/app/jobs", "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192" }] },
    { "name": "رزومه‌ها", "short_name": "رزومه‌ها", "url": "/app/candidates", "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192" }] },
    { "name": "اتوماسیون جذب", "short_name": "اتوماسیون", "url": "/app/automation", "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192" }] }
  ]
}
